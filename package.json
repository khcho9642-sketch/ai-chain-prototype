{
  "name": "ai-chain-prototype",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test --test-isolation=none \"tests/**/*.test.mjs\"",
    "test:community": "node --test \"tests/community/*.test.mjs\"",
    "ai:worker": "node scripts/community/ai-worker.mjs",
    "collect": "node scripts/data/collect-market.mjs",
    "collect:industry": "node scripts/data/collect-industry.mjs",
    "build:statistics": "node scripts/data/build-ai-statistics.mjs",
    "collect:tokens": "node scripts/data/collect-ai-tokens.mjs",
    "collect:disclosures": "node scripts/data/collect-ai-disclosures.mjs",
    "community:serve": "node scripts/community/community-server.mjs",
    "community:account": "node scripts/community/community-account.mjs",
    "community:backup": "node scripts/community/community-backup.mjs",
    "community:package": "node scripts/deployment/package-community.mjs",
    "community:check": "node scripts/deployment/community-check-public.mjs",
    "test:community:deploy": "npm run test:deployment",
    "collect:company-disclosures": "node scripts/data/collect-company-disclosures.mjs",
    "today:generate": "node scripts/community/today-picks.mjs --generate",
    "today:publish": "node scripts/community/today-picks.mjs --publish",
    "collect:comparison": "node scripts/data/collect-comparison-history.mjs",
    "test:deployment": "node --test \"tests/deployment/*.test.mjs\""
  }
}
